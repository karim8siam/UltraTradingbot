# Binance Futures Live API Credentials
BINANCE_API_KEY=YOUR_BINANCE_API_KEY
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET
DRY_RUN=true
USE_TESTNET=False
DEFAULT_LEVERAGE=5
MARGIN_FRACTION=0.001
RISK_PER_TRADE_PERCENT=0.1

# 5M Execution / 15M Structure / 1H BTC Sentinel
DEFAULT_TIMEFRAME=5m
HIGHER_TIMEFRAME=15m
ENABLE_BITCOIN_SENTINEL_LAYER=true
BTC_SENTINEL_TIMEFRAME=1h
PAUSE_NEW_TRADES=false
MAX_OPEN_TRADES=30

# Google Sheets Live Sync Webhook
GOOGLE_SHEET_WEBHOOK_URL=YOUR_GOOGLE_SHEET_WEBHOOK_URL

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_ADMIN_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Gemini AI
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
