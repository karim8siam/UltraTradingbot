# ==============================================================================
# Binance USDT-M Futures Unified API Credentials
# ==============================================================================
BINANCE_API_KEY=YOUR_BINANCE_API_KEY
BINANCE_API_SECRET=YOUR_BINANCE_API_SECRET

# ==============================================================================
# Master Execution Gates & Safety Controls
# (Default is DRY_RUN=true for zero-risk paper testing)
# To go LIVE with real funds, change:
# DRY_RUN=false
# LIVE_TRADING=true
# LIVE_TRADING_CONFIRMATION=true
# BINANCE_TESTNET=false
# ==============================================================================
DRY_RUN=true
LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=false
BINANCE_TESTNET=false
USE_TESTNET=false
PAPER_TRADING=false
EMERGENCY_STOP=false
PAUSE_NEW_TRADES=false

# ==============================================================================
# Global Risk & Sizing Controls
# ==============================================================================
DEFAULT_LEVERAGE=5
MARGIN_FRACTION=0.001
RISK_PER_TRADE_PERCENT=0.1
RISK_PER_TRADE=0.01

# ==============================================================================
# Multi-Timeframe Engine 1 Sentinel Settings
# ==============================================================================
DEFAULT_TIMEFRAME=5m
HIGHER_TIMEFRAME=15m
ENABLE_BITCOIN_SENTINEL_LAYER=true
BTC_SENTINEL_TIMEFRAME=1h
MAX_OPEN_TRADES=30

# ==============================================================================
# Optional Integrations (Telegram Alerts, Google Sheets, Gemini AI)
# ==============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
GEMINI_API_KEY=
GOOGLE_SHEET_WEBHOOK_URL=
