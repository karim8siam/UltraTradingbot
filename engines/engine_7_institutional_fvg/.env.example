# Binance API Configuration
# Never commit real credentials to version control.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Mode Gates (Section 1, 72)
BINANCE_TESTNET=true
DRY_RUN=true
PAPER_TRADING=false
LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=false
EMERGENCY_STOP=false

# Risk & Strategy Overrides (Optional - defaults in config.py)
DEFAULT_LEVERAGE=5
RISK_PER_TRADE=0.01
MIN_RR=2.0
MIN_SETUP_SCORE=11
