# Binance USDT-M Futures API Credentials
# IMPORTANT: API Keys must NEVER have withdrawal permission!
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Trading Environment & Strict Safety Gating
BINANCE_TESTNET=true
LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=false
PAPER_TRADING=false
DRY_RUN=true
EMERGENCY_STOP=false

# Trading Symbols (Top 30 Supported Pairs)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,SUIUSDT,AVAXUSDT,LINKUSDT,TRXUSDT,NEARUSDT,PEPEUSDT,ENAUSDT,SHIBUSDT,LTCUSDT,BCHUSDT,DOTUSDT,UNIUSDT,APTUSDT,WLDUSDT,TAOUSDT,FETUSDT,RENDERUSDT,OPUSDT,ARBUSDT,FILUSDT,INJUSDT,AAVEUSDT,CRVUSDT

# Risk Management Parameters (Specification Defaults)
RISK_PER_TRADE=0.01
DEFAULT_LEVERAGE=5
MIN_RR=2.0
MIN_SETUP_SCORE=11
MAX_DAILY_LOSS=none
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_HOURS=4.0
MAX_DAILY_TRADES=10
MAX_OPEN_POSITIONS=5
ENTRY_ORDER_TIMEOUT=30
MAX_SETUP_AGE=20

# Indicators & Thresholds
IMPULSE_MIN_ATR=2.0
MAX_ATR_RATIO=2.5
DATABASE_PATH=data/trading_bot.db
